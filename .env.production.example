# Production environment template for FleetOps Reports (EC2 / single-node).
# Copy to .env on the target host and replace every placeholder value.
# NEVER commit a populated .env file to version control.

# ----------------------------------------------------------
# Public exposure
# ----------------------------------------------------------

# Host port for the Nginx gateway (recommended: 8081 on EC2 free tier).
GATEWAY_HTTP_PORT=8081

# Application runtime environment.
APP_ENVIRONMENT=production

# Logging verbosity.
LOG_LEVEL=INFO

# JSON log file consumed by Promtail when the observability profile is enabled.
LOG_FILE_PATH=/var/log/fleetops-reports/app.log

# ----------------------------------------------------------
# MongoDB (recommended: MongoDB Atlas M0 free tier)
# ----------------------------------------------------------

# Atlas SRV connection string or embedded-db URI when using the embedded-db profile.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database_name>?retryWrites=true&w=majority

MONGODB_DATABASE=fleetops_reports

# Only required when starting Compose with --profile embedded-db
MONGO_INITDB_ROOT_USERNAME=change_me_mongo_user
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_password

# ----------------------------------------------------------
# MinIO (co-located on EC2)
# ----------------------------------------------------------

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_SECURE=false
MINIO_REPORTS_BUCKET=fleetops-reports
MINIO_GRAPHS_BUCKET=fleetops-graphs

# ----------------------------------------------------------
# FleetOps Security Gateway (operational data)
# ----------------------------------------------------------

# Public URL of the FleetOps Security API Gateway (deployed EC2 example).
OPERATIONAL_GATEWAY_BASE_URL=http://3.237.75.68:8000

# Route prefixes aligned with microservice internal paths (Gateway forwards full path).
OPERATIONAL_VEHICLES_PATH=/vehiculos/
OPERATIONAL_ASSIGNMENTS_PATH=/asignaciones/
OPERATIONAL_INCIDENTS_PATH=/api/incidents/
OPERATIONAL_MAINTENANCE_PATH=/api/v1/mantenimientos/

# Option A — static JWT from POST /auth/login (ADMINISTRADOR, ~60 min TTL):
OPERATIONAL_GATEWAY_BEARER_TOKEN=

# Option B — service account auto-login (recommended for production):
OPERATIONAL_GATEWAY_SERVICE_EMAIL=
OPERATIONAL_GATEWAY_SERVICE_PASSWORD=

# ----------------------------------------------------------
# Inbound JWT validation (Security Gateway forwarded tokens)
# ----------------------------------------------------------
#
# Deployed Security Service (RS256 — public key verification only):
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=/app/certs/public.pem
#
# Local legacy stack (HS256 shared secret — Security dev only):
# JWT_ALGORITHM=HS256
# JWT_SECRET_KEY=change_me_jwt_secret_key_minimum_32_characters_long

# ----------------------------------------------------------
# Resilience
# ----------------------------------------------------------

CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Optional external Jinja2 templates directory.
TEMPLATES_DIR=

# Enable POST /reports/generate/fixture (bundled synthetic data, no upstream MS).
FIXTURE_REPORTS_ENABLED=true

# ----------------------------------------------------------
# Observability profile (optional — disable on free-tier EC2)
# ----------------------------------------------------------

GRAFANA_HTTP_PORT=3000
GRAFANA_ADMIN_USER=change_me_grafana_user
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
