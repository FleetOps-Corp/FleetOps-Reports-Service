<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ title }}</title>

    <style>

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
            margin: 32px;
            line-height: 1.5;
            font-size: 14px;
        }

        h1 {
            color: #1e3a8a;
            margin-bottom: 0;
        }

        h2 {
            color: #374151;
            margin-top: 30px;
            border-bottom: 2px solid #d1d5db;
            padding-bottom: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background: #1e3a8a;
            color: white;
            padding: 10px;
        }

        td {
            border: 1px solid #d1d5db;
            padding: 8px;
        }

        .metadata {
            margin-top: 20px;
            background: #f9fafb;
            border: 1px solid #d1d5db;
            padding: 15px;
        }

        .metadata p {
            margin: 4px 0;
        }

        .summary {
            margin-top: 25px;
            padding: 18px;
            background: #f8fafc;
            border-left: 4px solid #2563eb;
        }

        .graph {
            text-align: center;
            margin-top: 25px;
        }

        .graph img {
            max-width: 100%;
        }

        footer {
            margin-top: 40px;
            font-size: 12px;
            color: gray;
            text-align: center;
            border-top: 1px solid #d1d5db;
            padding-top: 10px;
        }

    </style>

</head>

<body>

{% block content %}

{% endblock %}

</body>

</html>