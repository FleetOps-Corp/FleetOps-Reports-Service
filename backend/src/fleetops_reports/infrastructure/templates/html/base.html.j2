<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ title }}</title>

    <style>

        body {
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    color: #2d3748;
    background: #ffffff;
    margin: 40px;
    line-height: 1.6;
    font-size: 13px;
}

/* ---------- TITLES ---------- */

h1 {
    margin: 0;
    font-size: 28px;
    color: #0f4c81;
    font-weight: 700;
}

h2 {
    font-size: 18px;
    color: #1f2937;
    margin-top: 35px;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid #dbe4ee;
}

/* ---------- HEADER ---------- */

.metadata {
    margin-top: 22px;
    margin-bottom: 30px;
    padding: 18px;
    background: #f8fafc;
    border-left: 6px solid #0f4c81;
    border-radius: 4px;
}

.metadata p {
    margin: 6px 0;
}

.metadata strong {
    display: inline-block;
    width: 120px;
    color: #1f2937;
}
.report-header {
    border-bottom: 3px solid #0f4c81;
    padding-bottom: 15px;
    margin-bottom: 20px;
}

.subtitle {
    margin-top: 6px;
    color: #6b7280;
    font-size: 14px;
}

/* ---------- EXECUTIVE SUMMARY ---------- */

.summary {
    background: #f9fbfd;
    border: 1px solid #dde6ef;
    border-radius: 6px;
    padding: 20px;
    margin-top: 25px;
}

.summary p {
    text-align: justify;
}

/* ---------- TABLE ---------- */

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 18px;
    font-size: 13px;
}

thead {
    background: #0f4c81;
}

thead th {
    color: white;
    padding: 12px;
    font-weight: 600;
    text-align: left;
}

tbody tr:nth-child(even) {
    background: #f7f9fb;
}

tbody tr:hover {
    background: #edf5fc;
}

tbody td:first-child {
    font-weight: 600;
    color: #0f4c81;
}

tbody td:first-child {
    font-weight: 600;
    color: #0f4c81;
}

td {
    padding: 11px;
    border-bottom: 1px solid #dbe4ee;
}

/* ---------- GRAPH ---------- */

.graph {
    margin-top: 35px;
    text-align: center;
}

.graph img {
    width: 90%;
    max-width: 650px;
    border: 1px solid #dbe4ee;
    border-radius: 5px;
    padding: 10px;
    background: white;
}

/* ---------- FOOTER ---------- */

footer {
    margin-top: 50px;
    padding-top: 15px;
    border-top: 1px solid #dbe4ee;
    text-align: center;
    color: #6b7280;
    font-size: 11px;
}

/* ---------- PRINT ---------- */

@page {
    size: A4;
    margin: 2cm;
}
    </style>

</head>

<body>

{% block content %}

{% endblock %}

</body>

</html>