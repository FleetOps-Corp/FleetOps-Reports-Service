<h2>Fleet Inventory</h2>

<p style="color:#6b7280;margin-top:-8px;">
Units included in this report scope, sorted by operational status (available first).
</p>

<table>
<thead>
<tr>
<th>Plate</th>
<th>Brand / Model</th>
<th>Status</th>
<th>Operation Site</th>
<th>Operation City</th>
</tr>
</thead>
<tbody>
{% for vehicle in vehicles %}
<tr>
<td>{{ vehicle.plate }}</td>
<td>{{ vehicle.brand_model }}</td>
<td>{{ vehicle.status_label }}</td>
<td>{{ vehicle.sede_operacion }}</td>
<td>{{ vehicle.ciudad_operacion }}</td>
</tr>
{% endfor %}
</tbody>
</table>
