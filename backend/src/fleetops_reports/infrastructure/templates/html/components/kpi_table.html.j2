<h2>Key Performance Indicators</h2>

<table>

<thead>

<tr>

<th>KPI</th>

<th>Metric</th>

<th>Value</th>

<th>Source</th>

</tr>

</thead>

<tbody>

{% for kpi in kpis %}

<tr>

<td>{{ kpi.name }}</td>

<td>{{ kpi.metric }}</td>

<td>{{ kpi.value }} {{ kpi.unit }}</td>

<td>{{ kpi.source }}</td>

</tr>

{% endfor %}

</tbody>

</table>