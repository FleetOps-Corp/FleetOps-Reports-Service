<!doctype html>
<!--
SAD Traceability: Template View Pattern for executive PDF reports described in
section 10.6, combining KPIs, tables and presigned graph URLs.
-->
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <style>
      body { font-family: Arial, sans-serif; color: #1f2937; margin: 32px; }
      h1 { font-size: 26px; margin-bottom: 4px; }
      table { border-collapse: collapse; width: 100%; margin-top: 24px; }
      th, td { border: 1px solid #d1d5db; padding: 8px; text-align: left; }
      th { background: #f3f4f6; }
      img { max-width: 100%; margin-top: 24px; }
    </style>
  </head>
  <body>
    <h1>{{ title }}</h1>
    <p>Report ID: {{ report_id }}</p>
    <p>Period: {{ period }}</p>
    <table>
      <thead>
        <tr><th>KPI</th><th>Metric</th><th>Value</th><th>Source</th></tr>
      </thead>
      <tbody>
        {% for kpi in kpis %}
        <tr>
          <td>{{ kpi.name }}</td>
          <td>{{ kpi.metric }}</td>
          <td>{{ kpi.value }} {{ kpi.unit }}</td>
          <td>{{ kpi.source }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <img src="{{ graph_url }}" alt="FleetOps KPI graph">
  </body>
</html>

