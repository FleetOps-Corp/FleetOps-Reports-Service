# SAD Traceability: all runtime configuration is externalized per prompt hard constraints.

# Public host port for the local API Gateway.
GATEWAY_HTTP_PORT=8080

# Public host port for Grafana dashboards.
GRAFANA_HTTP_PORT=3000

# Public host port for MinIO API.
MINIO_API_PORT=9000

# Public host port for MinIO console.
MINIO_CONSOLE_PORT=9001

# Application runtime environment name.
APP_ENVIRONMENT=local

# Logging verbosity consumed by structured logging.
LOG_LEVEL=INFO

# Optional JSON log file path mounted for Promtail/Loki collection.
LOG_FILE_PATH=/var/log/fleetops-reports/app.log

# MongoDB connection string for local development or MongoDB Atlas in production.
MONGODB_URI=mongodb://fleetops_user:change_me_password@mongodb:27017/fleetops_reports?authSource=admin

# MongoDB database name for analytical persistence.
MONGODB_DATABASE=fleetops_reports

# MongoDB root username for local development container.
MONGO_INITDB_ROOT_USERNAME=fleetops_user

# MongoDB root password placeholder for local development container.
MONGO_INITDB_ROOT_PASSWORD=change_me_password

# MinIO internal endpoint used by the backend container.
MINIO_ENDPOINT=minio:9000

# MinIO root/access key placeholder for local development.
MINIO_ACCESS_KEY=change_me_access_key

# MinIO secret key placeholder for local development.
MINIO_SECRET_KEY=change_me_secret_key

# Whether backend uses HTTPS when calling MinIO.
MINIO_SECURE=false

# Bucket for generated PDF reports.
MINIO_REPORTS_BUCKET=fleetops-reports

# Bucket for generated chart resources.
MINIO_GRAPHS_BUCKET=fleetops-graphs

# Operational API Gateway base URL (FleetOps Security Gateway).
# From Reports backend container use host.docker.internal to reach the host gateway.
OPERATIONAL_GATEWAY_BASE_URL=http://host.docker.internal:8000

# JWT with ADMINISTRADOR role required by Security Gateway for operational routes.
# Obtain via POST /auth/login against the Security Gateway.
OPERATIONAL_GATEWAY_BEARER_TOKEN=

# Circuit breaker failure threshold before opening.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# Circuit breaker recovery window in seconds.
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Optional external Jinja2 template directory; leave empty to use packaged templates.
TEMPLATES_DIR=

# Grafana local admin username placeholder.
GRAFANA_ADMIN_USER=fleetops_admin

# Grafana local admin password placeholder.
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

